# AgentGate production environment (Contabo VPS).
# Copy to .env.production and fill in real values. Never commit .env.production.

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=app.example.com
TRUSTED_PROXY_COUNT=1
DJANGO_ADMIN_PATH=admin/

# --- Database (Neon PostgreSQL, direct URL for migrations/worker) ---
DATABASE_URL=postgresql://user:password@host.neon.tech/agentgate_prod?sslmode=require

# --- Redis (cache; internal Docker network only) ---
REDIS_PASSWORD=replace-with-a-strong-password
REDIS_URL=redis://:replace-with-a-strong-password@redis:6379/0

# --- Security ---
CSRF_TRUSTED_ORIGINS=https://app.example.com
SECURE_HSTS_SECONDS=31536000
FRONTEND_ORIGIN=https://app.example.com

# --- MFA (required; fail-closed at startup if missing) ---
MFA_ENCRYPTION_KEY=replace-with-fernet-key
MFA_ENCRYPTION_PREVIOUS_KEYS=
MFA_BYPASS_CODE=replace-with-emergency-bypass-code

# --- Caddy / TLS ---
DOMAIN=app.example.com

# --- Gunicorn ---
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# --- Procrastinate worker ---
# PROCRASTINATE_WORKER_QUEUES is NOT consumed: the worker command in compose.yaml
# fixes the queues to smoke,approvals (architectural decision).
# PROCRASTINATE_WORKER_LISTEN_NOTIFY and PROCRASTINATE_WORKER_DELETE_JOBS are
# NOT consumed: the worker command passes --listen-notify and
# --delete-jobs=SUCCESSFUL explicitly to guarantee safe defaults.
# The following variable IS consumed by Procrastinate via the environment:
PROCRASTINATE_WORKER_CONCURRENCY=1

# --- Optional: email ---
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=AgentGate <no-reply@example.com>

# --- Optional: GitHub OAuth ---
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_SECRET=

# --- PayPal: INTENTIONALLY ABSENT ---
# PayPal sandbox is a separate local development concern.
# Do not add PayPal credentials or feature flags to this file.
# See docs/research/CORE_BACKEND_DEPLOYMENT_READINESS.md section 5.
