[importlinter]
root_packages =
    config
    gate
    engine
    apps
include_external_packages = True

[importlinter:contract:engine-is-pure]
name = The engine is pure Python and framework-free
type = forbidden
source_modules =
    engine
forbidden_modules =
    django
    rest_framework
    apps
    procrastinate

[importlinter:contract:paypal-isolation]
name = Only the payments app may import the PayPal client directly
type = forbidden
# Other apps may call the payment service/dispatch, which reach the PayPal
# client inside the payments app; only a direct PayPal client import is a
# contract violation.
allow_indirect_imports = true
# Add each application package here when it is created.
source_modules =
    config
    gate
    engine
    apps.accounts
    apps.agents
    apps.policies
    apps.payees
    apps.spend
    apps.approvals
    apps.audit
    apps.common
    apps.background
forbidden_modules =
    apps.payments.paypal
