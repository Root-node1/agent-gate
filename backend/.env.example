# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SETTINGS_MODULE=config.settings.dev

# PostgreSQL. Leave unset to use the local SQLite file.
# Use the direct Neon URL for migrations and the worker.
# DATABASE_URL=postgresql://user:password@localhost:5432/agentgate?sslmode=require
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/agentgate_test

# THROTTLE_AGENT=60/min
# THROTTLE_ANON=20/min
# DEMO_ORG_NAME=demo

# Production only
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# SECURE_HSTS_SECONDS=31536000
# DJANGO_ADMIN_PATH=admin/

# PayPal sandbox (add when the integration lands)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
