# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SETTINGS_MODULE=config.settings.dev

# PostgreSQL 17 is required for local development migrations (Procrastinate
# uses PostgreSQL-only schema).
#
# run.sh starts a PostgreSQL 17 container automatically and uses this default
# URL. If you run PostgreSQL differently, change this value:
DATABASE_URL=postgresql://agentgate:agentgate-local-only@127.0.0.1:55432/agentgate
#
# For a host-installed PostgreSQL 17:
# DATABASE_URL=postgresql://user:password@localhost:5432/agentgate
#
# Separate test database (used by `python manage.py test`):
# TEST_DATABASE_URL=postgresql://agentgate:agentgate-local-only@127.0.0.1:55432/agentgate_test

# Trusted reverse proxies in front of Django: 0 direct, 1 Caddy only, 2 CDN plus Caddy.
# TRUSTED_PROXY_COUNT=0

# THROTTLE_AGENT=60/min
# THROTTLE_ANON=20/min
# THROTTLE_DEMO=60/min
# INJECTION_CLASSIFIER=path.to.classifier.callable
# INJECTION_CLASSIFIER_TIMEOUT_SECONDS=2
# --- Demo mode ---
# Anonymous demo reads are always allowed when DEMO_MODE=true. Writes such as
# approve/deny stay disabled unless DEMO_MODE_ALLOW_WRITES=true. Outside DEBUG,
# startup refuses DEMO_MODE=true unless DEMO_MODE_ALLOW_PRODUCTION=true.
DEMO_MODE=false
DEMO_MODE_ALLOW_WRITES=false
DEMO_MODE_ALLOW_PRODUCTION=false
# DEMO_ORG_NAME=demo
# DEMO_USERNAME=demo-viewer

# Production only
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# SECURE_HSTS_SECONDS=31536000
# DJANGO_ADMIN_PATH=admin/

# Frontend origin used to build allauth password-reset / signup links.
# FRONTEND_ORIGIN=https://app.example.com

# Transactional email (password reset, verification, notifications).
# Leave EMAIL_HOST unset to use the console backend (development).
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=AgentGate <no-reply@example.com>

# --- Payment execution ---
# fake (default, no provider calls) or paypal (sandbox Payouts).
# PAYMENT_EXECUTOR=fake
# FAKE_EXECUTOR_MODE=succeed
# PAYMENTS_EXECUTION_ENABLED=true

# --- Webhook retention ---
# Processed PayPal webhook payloads are cleared after this many days.
# WEBHOOK_RETENTION_DAYS=30

# --- PayPal Payouts (sandbox only) ---
# Sandbox credentials come from https://developer.paypal.com/dashboard.
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_BASE_URL=
# PAYPAL_TIMEOUT_SECONDS=10
# PAYPAL_MAX_RETRIES=2
# Live movement is refused unless this is explicitly enabled.
# PAYPAL_ALLOW_LIVE=

# PayPal sandbox (add when the integration lands)
# Only the sandbox environment is supported. Production is rejected.
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_CHECKOUT_ENABLED=false
# PAYPAL_PAYOUTS_ENABLED=false

# --- GitHub OAuth (allauth SocialAccount) ---
# OAuth App credentials registered at https://github.com/settings/developers
# Callback URL: https://<backend-host>/accounts/github/login/callback/
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_SECRET=
# Optional: GitHub Enterprise base URL (leave blank for github.com)

# --- MFA secret encryption (AUTH-05B.2) ---
# Fernet key (AES-256-CBC + HMAC-SHA256) for encrypting TOTP secrets and
# recovery-code seeds at rest.  Independent of DJANGO_SECRET_KEY.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Comma-separated older keys for decryption-only rotation (MultiFernet).
MFA_ENCRYPTION_PREVIOUS_KEYS=

# --- Procrastinate background jobs ---
# Procrastinate uses the Django default PostgreSQL database (DATABASE_URL).
# The worker must use the direct Neon URL, not the transaction pooler, because
# LISTEN/NOTIFY does not work through a pooler.
# PROCRASTINATE_DATABASE_ALIAS=default

# ---------------------------------------------------------------------------
# PayPal Sandbox end-to-end (INT-13M.3)
# ---------------------------------------------------------------------------
# Isolated, disposable configuration only. Never use production credentials
# or production databases. Copy this block into a local .env file and fill
# in Sandbox values.
#
# PAYPAL_ENV=sandbox                 # only "sandbox" is supported
# PAYPAL_CLIENT_ID=                  # Sandbox REST app client ID
# PAYPAL_CLIENT_SECRET=              # Sandbox REST app client secret
# PAYPAL_WEBHOOK_ID=                 # Sandbox webhook ID from PayPal dashboard
# PAYPAL_CHECKOUT_ENABLED=false      # enable checkout workflow
# PAYPAL_PAYOUTS_ENABLED=false       # enable payout workflow
#
# Local backend/frontend ports
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
#
# Webhook callback URL pattern (ngrok HTTPS tunnel):
# https://<ngrok-subdomain>.ngrok.io/v1/webhooks/paypal/
#
# CSRF / allowed hosts for local Sandbox:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<ngrok-subdomain>.ngrok.io
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://<ngrok-subdomain>.ngrok.io
# CORS_ALLOWED_ORIGINS=http://localhost:5173
#
# MFA prerequisite:
# MFA_ENCRYPTION_KEY=<fernet key>
#
# Database isolation:
# Use a dedicated local PostgreSQL database, never the test database
# (test_agentgate) and never production.
# DATABASE_URL=postgres://agentgate:agentgate@127.0.0.1:5432/agentgate_sandbox
