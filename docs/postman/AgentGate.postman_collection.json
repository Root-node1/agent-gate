    {
      "name": "Dashboard Authentication",
      "item": [
        {
          "name": "Login (POST /api-auth/login/)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api-auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api-auth", "login", ""]
            },
            "description": "Django REST Framework session login. Sets a session cookie used by all dashboard endpoints. Requires a user with an OrgMembership (admin, approver, or viewer)."
          },
          "response": []
        },
        {
          "name": "Logout (POST /api-auth/logout/)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api-auth/logout/",
              "host": ["{{base_url}}"],
              "path": ["api-auth", "logout", ""]
            },
            "description": "Destroys the current session."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard: Agents",
      "item": [
        {
          "name": "List agents (GET /v1/agents/)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/agents/?limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["v1", "agents", ""],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Page size (max 200, default 50)"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Page offset"
                }
              ]
            },
            "description": "List agents belonging to the caller's organizations. Requires SessionAuthentication with any org membership (viewer+). Returns only `current_key_prefix` — never the full key or hash."
          },
          "response": []
        },
        {
          "name": "Create agent (POST /v1/agents/)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"billing-agent\",\n  \"organization\": \"{{organization_uuid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/agents/",
              "host": ["{{base_url}}"],
              "path": ["v1", "agents", ""]
            },
            "description": "Create an agent and its first API key. Requires SessionAuthentication with admin role in the specified organization. The `api_key` field in the response is the only time the raw key is returned — store it safely.\n\nStatus codes:\n- 201: Agent created (read `api_key` in response body)\n- 400: Validation error (name whitespace, duplicate name, unknown field, cross-org)\n- 403: Caller is not an admin of the specified organization"
          },
          "response": []
        },
        {
          "name": "Get agent detail (GET /v1/agents/{id}/)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/agents/{{agent_uuid}}/",
              "host": ["{{base_url}}"],
              "path": ["v1", "agents", "{{agent_uuid}}", ""]
            },
            "description": "Retrieve agent detail including current key prefix, policies, and spend totals. Requires SessionAuthentication with any org membership (viewer+). Returns 404 if the agent is not in the caller's organizations."
          },
          "response": []
        },
        {
          "name": "Update agent (PATCH /v1/agents/{id}/)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"suspended\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/agents/{{agent_uuid}}/",
              "host": ["{{base_url}}"],
              "path": ["v1", "agents", "{{agent_uuid}}", ""]
            },
            "description": "Update an agent's name or status (active/suspended). Requires SessionAuthentication with admin role. Suspending an agent immediately blocks its API key from authenticating spend requests.\n\nStatus codes:\n- 200: Agent updated\n- 400: Invalid status, name collision, or unknown field\n- 403: Caller is not an admin\n- 404: Agent not found in caller's organizations"
          },
          "response": []
        },
        {
          "name": "Rotate key (POST /v1/agents/{id}/rotate-key/)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/agents/{{agent_uuid}}/rotate-key/",
              "host": ["{{base_url}}"],
              "path": ["v1", "agents", "{{agent_uuid}}", "rotate-key", ""]
            },
            "description": "Create a new API key and revoke the previous one. The old key is revoked (soft-deleted). The new raw key is returned in the response — store it safely. Requires SessionAuthentication with admin role.\n\nStatus codes:\n- 200: Key rotated\n- 403: Caller is not an admin\n- 404: Agent not found in caller's organizations"
          },
          "response": []
        },
        {
          "name": "Revoke key (POST /v1/agents/{id}/revoke-key/)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/agents/{{agent_uuid}}/revoke-key/",
              "host": ["{{base_url}}"],
              "path": ["v1", "agents", "{{agent_uuid}}", "revoke-key", ""]
            },
            "description": "Revoke the agent's current API key (soft-delete via revoked_at). After revocation, the key prefix in list/detail responses becomes null. Requires SessionAuthentication with admin role.\n\nStatus codes:\n- 200: Key revoked\n- 400: No active API key to revoke\n- 403: Caller is not an admin\n- 404: Agent not found in caller's organizations"
          },
          "response": []
        }
      ]
    },
    {
      "item": [
        {
          "name": "Submit spend request (POST /v1/spend-requests/)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer agk_YOUR_AGENT_KEY"
              },
              {
                "key": "Idempotency-Key",
                "value": "7f2c9d1e-4a3b-4c5d-8e9f-0a1b2c3d4e5f"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"10.00\",\n  \"currency\": \"USD\",\n  \"merchant\": \"acme.com\",\n  \"purpose\": \"API credits\",\n  \"source\": \"trusted\",\n  \"source_ref\": \"\",\n  \"evidence_excerpt\": \"\",\n  \"destination_type\": \"paypal_email\",\n  \"destination_value\": \"seller@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/spend-requests/",
              "host": ["{{base_url}}"],
              "path": ["v1", "spend-requests", ""]
            },
            "description": "Submit a spend request authenticated by agent key. The Idempotency-Key header is required (1-255 printable chars). The response is HTTP 201 for EVERY decision — read the `decision` field (allow, deny, or needs_approval), never the status code alone.\n\nStatus codes:\n- 201: Request processed (read `decision` in body)\n- 400: Missing/invalid Idempotency-Key or validation error\n- 401: Invalid agent key\n- 409: Agent has no policy, or Idempotency-Key reused with a different body\n- 429: Rate limited (60/min per agent key)\n\nIf the same Idempotency-Key and body are replayed, the response includes `Idempotent-Replayed: true`."
          },
          "response": []
        },
        {
          "name": "Get spend request (GET /v1/spend-requests/{id}/)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer agk_YOUR_AGENT_KEY"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/spend-requests/{{spend_request_id}}/",
              "host": ["{{base_url}}"],
              "path": ["v1", "spend-requests", "{{spend_request_id}}", ""]
            },
            "description": "Retrieve one of the calling agent's own spend requests. Returns 404 if the ID does not belong to this agent."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard: Approvals",
      "item": [
        {
          "name": "List approvals (GET /v1/approvals/)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/approvals/?outcome=pending&limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["v1", "approvals", ""],
              "query": [
                {
                  "key": "outcome",
                  "value": "pending",
                  "description": "Filter: pending | approved | denied | expired | all. Default: pending"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Page size (max 200, default 50)"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Page offset"
                }
              ]
            },
            "description": "List approvals scoped to the caller's organizations and roles. Requires SessionAuthentication with approver or admin role. Results are paginated via limit/offset."
          },
          "response": []
        },
        {
          "name": "Get approval detail (GET /v1/approvals/{id}/)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/approvals/{{approval_id}}/",
              "host": ["{{base_url}}"],
              "path": ["v1", "approvals", "{{approval_id}}", ""]
            },
            "description": "Retrieve a single approval. The caller must have approver or admin role in the approval's organization."
          },
          "response": []
        },
        {
          "name": "Approve request (POST /v1/approvals/{id}/approve/)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"note\": \"Approved after review\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/approvals/{{approval_id}}/approve/",
              "host": ["{{base_url}}"],
              "path": ["v1", "approvals", "{{approval_id}}", "approve", ""]
            },
            "description": "Approve a pending request. The backend re-runs the CURRENT policy and budget as a recheck before deciding. If a hard rule now denies the request, or the payee destination fingerprint changed, the API returns 409 with `rules` in the body and leaves the approval pending.\n\nStatus codes:\n- 200: Approval executed successfully\n- 404: Approval not found\n- 409: Approval expired, or recheck failed (hard deny or destination change)\n- 429: Rate limited"
          },
          "response": []
        },
        {
          "name": "Deny request (POST /v1/approvals/{id}/deny/)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"note\": \"Denied by human review\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/approvals/{{approval_id}}/deny/",
              "host": ["{{base_url}}"],
              "path": ["v1", "approvals", "{{approval_id}}", "deny", ""]
            },
            "description": "Deny a pending request. Idempotent: re-sending the same decision is safe."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard: Policies",
      "item": [
        {
          "name": "List policies (GET /v1/policies/)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/policies/?limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["v1", "policies", ""],
              "query": [
                {
                  "key": "agent",
                  "value": "",
                  "description": "Optional UUID to filter by agent"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Page size (max 200, default 50)"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Page offset"
                }
              ]
            },
            "description": "List policy versions for the caller's organizations. Requires SessionAuthentication with any org membership (viewer+). Response includes nested `merchant_rules` array — transform to `allowed_merchants` and `blocked_merchants` arrays on the frontend."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Dashboard: Audit Log",
      "item": [
        {
          "name": "List audit events (GET /v1/audit/)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/audit/?event_type=request.received&agent={{agent_uuid}}&spend_request={{spend_request_uuid}}&after=0&limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["v1", "audit", ""],
              "query": [
                {
                  "key": "event_type",
                  "value": "request.received",
                  "description": "Filter by event type (single value)"
                },
                {
                  "key": "agent",
                  "value": "{{agent_uuid}}",
                  "description": "UUID of the agent"
                },
                {
                  "key": "spend_request",
                  "value": "{{spend_request_uuid}}",
                  "description": "UUID of the spend request"
                },
                {
                  "key": "after",
                  "value": "0",
                  "description": "Cursor: return events with id greater than this integer"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Page size (max 200, default 50)"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Page offset"
                }
              ]
            },
            "description": "List audit events for the caller's organizations. Requires SessionAuthentication with any org membership (viewer+). Event types: request.received, decision.made, approval.requested, approval.approved, approval.denied, approval.expired, demo.reset.\n\nNote: actor filtering and date-range filtering are NOT supported by the current API — these are frontend demo store features that have no backend equivalent."
          },
          "response": []
        },
        {
          "name": "Verify audit chain (GET /v1/audit/verify/)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/audit/verify/",
              "host": ["{{base_url}}"],
              "path": ["v1", "audit", "verify", ""]
            },
            "description": "Verify audit hash chains for all organizations where the caller is an admin. Returns 409 if any chain is broken (tamper-evident). Returns 200 with checked/organizations counts on success."
          },
          "response": []
        }
      ]
    }
  ],
