# AgentGate frontend environment variables.
# Copy to frontend/.env.local and fill in real values.
# Never commit frontend/.env.local.

# Production API base URL.
# When set, all API requests target this origin (cross-origin mode).
# When unset, requests use relative paths (same-origin mode with Vite dev proxy).
# VITE_API_BASE_URL=https://api.agentgate.zindika.app
