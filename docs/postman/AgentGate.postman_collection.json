    "_postman_id": "agentgate-api-0.1.0",
    "name": "AgentGate API",
    "description": "Spending firewall between AI agents and PayPal. Agents authenticate with Bearer keys (agk_...). Dashboard users authenticate with Django session cookies via /api-auth/login/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": {
